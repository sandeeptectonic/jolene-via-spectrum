{% comment %}
  Renders a product card — Tectonic / Spectrum design.

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - media_aspect_ratio: {String} Unused — kept for backwards compat
  - image_shape: {String} Unused — kept for backwards compat
  - show_secondary_image: {Boolean} Show secondary image on hover. Default: false
  - show_vendor: {Boolean} Show product vendor. Default: false
  - show_rating: {Boolean} Show product rating. Default: false
  - extend_height: {Boolean} Unused — kept for backwards compat
  - lazy_load: {Boolean} Lazy load images. Default: true
  - show_quick_add: {Boolean} Unused — ATC always shows
  - section_id: {String} Section ID for unique element IDs
  - horizontal_class: {Boolean} Unused — kept for backwards compat
  - horizontal_quick_add: {Boolean} Unused — kept for backwards compat

  Usage:
  {% render 'card-product', card_product: product, show_secondary_image: true, section_id: section.id %}
{% endcomment %}

{{ 'spectrum-card.css' | asset_url | stylesheet_tag }}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign variant = card_product.selected_or_first_available_variant
    assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id
  -%}

  <div class="card-wrapper product-card-wrapper">
    <div class="product-card">

      {%- comment -%} IMAGE AREA {%- endcomment -%}
      <div class="product-card__image-wrapper">
        <a href="{{ card_product.url }}" class="product-card__link">
          {%- if card_product.featured_media -%}
            {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
            <img
              srcset="
                {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                {%- if card_product.featured_media.width >= 1066 -%}{{ card_product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
              "
              src="{{ card_product.featured_media | image_url: width: 533 }}"
              sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
              alt="{{ card_product.featured_media.alt | escape }}"
              class="product-card__image-1"
              {% unless lazy_load == false %}loading="lazy"{% endunless %}
              width="{{ card_product.featured_media.width }}"
              height="{{ card_product.featured_media.height }}"
            >
            {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}

            {%- if card_product.media[1] != null and show_secondary_image -%}
              <img
                srcset="
                  {%- if card_product.media[1].width >= 165 -%}{{ card_product.media[1] | image_url: width: 165 }} 165w,{%- endif -%}
                  {%- if card_product.media[1].width >= 360 -%}{{ card_product.media[1] | image_url: width: 360 }} 360w,{%- endif -%}
                  {%- if card_product.media[1].width >= 533 -%}{{ card_product.media[1] | image_url: width: 533 }} 533w,{%- endif -%}
                  {%- if card_product.media[1].width >= 720 -%}{{ card_product.media[1] | image_url: width: 720 }} 720w,{%- endif -%}
                  {%- if card_product.media[1].width >= 940 -%}{{ card_product.media[1] | image_url: width: 940 }} 940w,{%- endif -%}
                  {%- if card_product.media[1].width >= 1066 -%}{{ card_product.media[1] | image_url: width: 1066 }} 1066w,{%- endif -%}
                  {{ card_product.media[1] | image_url }} {{ card_product.media[1].width }}w
                "
                src="{{ card_product.media[1] | image_url: width: 533 }}"
                sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                alt=""
                class="product-card__image-2"
                loading="lazy"
                width="{{ card_product.media[1].width }}"
                height="{{ card_product.media[1].height }}"
              >
            {%- endif -%}
          {%- endif -%}
        </a>

        {%- comment -%} BADGES — top-left {%- endcomment -%}
        {% render 'spectrum-badges', product: card_product, context: 'card' %}

        {%- comment -%} MOBILE ATC ICON — bottom-right of image {%- endcomment -%}
        {%- if variant.available -%}
          <button
            class="product-card__atc-icon"
            aria-label="{{ 'products.product.add_to_cart' | t }} - {{ card_product.title | escape }}"
            data-variant-id="{{ variant.id }}"
            onclick="event.preventDefault();event.stopPropagation();fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:{{ variant.id }},quantity:1}]})}).then(function(){window.location.href='/cart';});"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
          </button>
        {%- endif -%}
      </div>

      {%- comment -%} DESCRIPTION + DESKTOP ATC {%- endcomment -%}
      <div class="product-card__desc-wrapper">
        <div class="product-card__desc">
          <h3 class="product-card__title" id="title-{{ section_id }}-{{ card_product.id }}">
            <a href="{{ card_product.url }}">
              {{ card_product.title | escape }}
            </a>
          </h3>

          {%- if show_vendor -%}
            <p class="product-card__vendor">{{ card_product.vendor }}</p>
          {%- endif -%}

          <div class="product-card__price-row">
            {%- if card_product.compare_at_price > card_product.price and card_product.available -%}
              <span class="product-card__sale-price">{{ card_product.price | money }}</span>
              <span class="product-card__compare-price">{{ card_product.compare_at_price | money | split: '.' | first }}</span>
              {%- liquid
                assign discount_amount = card_product.compare_at_price | minus: card_product.price
                assign discount_pct = discount_amount | times: 100 | divided_by: card_product.compare_at_price
              -%}
              <span class="product-card__discount">{{ discount_pct }}% OFF</span>
            {%- else -%}
              <span class="product-card__sale-price">{{ card_product.price | money }}</span>
            {%- endif -%}
          </div>
        </div>

        {%- comment -%} DESKTOP ATC OVERLAY — hidden on mobile {%- endcomment -%}
        <div class="product-card__atc">
          <product-form>
            {%- form 'product', card_product, id: product_form_id, class: 'product-card__atc-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" value="{{ variant.id }}" disabled>
              <button
                id="{{ product_form_id }}-submit"
                type="submit"
                name="add"
                class="product-card__atc-btn"
                aria-label="{{ 'products.product.add_to_cart' | t }} - {{ card_product.title | escape }}"
                {% unless variant.available %}disabled{% endunless %}
              >
                {%- if variant.available -%}
                  ADD TO BAG
                {%- else -%}
                  SOLD OUT
                {%- endif -%}
              </button>
              <div class="loading-overlay__spinner hidden">
                <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg>
              </div>
            {%- endform -%}
          </product-form>
        </div>
      </div>

    </div>
  </div>

{%- else -%}
  <div class="card-wrapper product-card-wrapper">
    <div class="product-card">
      <div class="product-card__image-wrapper">
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image-1' }}
      </div>
      <div class="product-card__desc-wrapper">
        <div class="product-card__desc">
          <h3 class="product-card__title">
            <a role="link" aria-disabled="true">{{ 'onboarding.product_title' | t }}</a>
          </h3>
          <div class="product-card__price-row">
            <span class="product-card__sale-price">{{ 1999 | money }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

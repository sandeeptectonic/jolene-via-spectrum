<style>
  /* .product_column_1._large{
    min-width:70%;
  } */
</style>
{% if section.settings.heading != blank %}
<div class="nd_heading page-width"">
   <h1>{{ section.settings.heading }}</h1>
</div>
{% endif %}  
{%- for block in section.blocks -%}
 
     {% if block.type == "2_products" %}
        <div class="container nd_2_products_wrap page-width" >
          {% if block.settings.product_1 != blank %}
            <div class="product_column_1 {% if block.settings.make_large %} _large {% endif %}">
              <a href="{{ block.settings.product_1.url }}">
                {{ block.settings.product_1_img | image_url:width:700, height:700, crop:"center" | image_tag }}
                              </a>
              <a href="{{ block.settings.product_1.url }}">
                 <h3>{{ block.settings.product_1.title }}</h3>
              </a>
              <a href="{{ block.settings.product_1.url }}">
                 <p>{{ block.settings.product_1.price | money }}</p>
              </a>

            </div>
          {% endif %}  
        {% if block.settings.product_2 != blank %}
            <div class="product_column_1 {% unless block.settings.make_large %} _large {% endunless %}">
               <a href="{{ block.settings.product_2.url }}">
                {{ block.settings.product_2_img | image_url:width:700, height:700, crop:"center" | image_tag }}
                 <h3>{{ block.settings.product_2.title }}</h3>
                 <p>{{ block.settings.product_2.price | money }}</p>
               </a>
            </div>
          {% endif %} 
        </div>
     {% elsif block.type == "2_banners" %}
        <div class="container nb_2_banners_wrap page-width">
             {% if block.settings.image_1 != blank %}
               
                 <div class="nb_2_banners_box">
                   <a href="{{ block.settings.product_2_img.url }}">
                  {{ block.settings.image_1 | image_url:width:700, height:700, crop:"center" | image_tag }}
                     </a>
                 </div>

             {% endif %}
           {% if block.settings.image_2 != blank %}

                  <div class="nb_2_banners_box">
                    <a href="{{ block.settings.product_2_img.url }}">
                  {{ block.settings.image_2 | image_url:width:700, height:700, crop:"center" | image_tag }}
                    </a>
                  </div>
               
             {% endif %}
        </div>
      
       <div class="nb_content_box page-width">
         {% if block.settings.heading != blank %}
           <div class="nb_left_box">
          <h3>{{ block.settings.product_2_img.title }}</h3>
            <p>{{ block.settings.product_2_img.price | money }}</p>
           </div>
         {% endif %} 
         {% if block.settings.content != blank %}
           <div class="nb_right_box">
              {{ block.settings.content }}
           </div>
         {% endif %} 
       </div>
       {% elsif block.type == "2_banners_product" %}  
       <div class="container nb_3_banners_img_wrap page-width" >
         {% if block.settings.image_1 != blank %}
          <div class="nb_1_img_box">
            <a href="{{ block.settings.product.url }}">
              {{ block.settings.image_1 | image_url:width:700 | image_tag }}
              <h3>{{ block.settings.title_1 }}</h3>
            </a>
          </div>  
         {% endif %}
          {% if block.settings.product != blank %}
          <div class="nb_2_img_box">
            <a href="{{ block.settings.product.url }}">
              {{ block.settings.image_2 | image_url:width:700 | image_tag }}
              <h3>{{ block.settings.product.title }}</h3>
              <p>{{ block.settings.product.price | money }}</p>
            </a>
          </div>  
         {% endif %}
         {% if block.settings.image_3 != blank %}
          <div class="nb_3_img_box">
           <a href="{{ block.settings.product.url }}">
              {{ block.settings.image_3 | image_url:width:700 | image_tag }}
              <h3>{{ block.settings.title_2 }}</h3>
            </a>
          </div>  
           
         {% endif %}
       </div>
      {% elsif block.type == "featured_collection" %}  
       <div class="nd_grid_wrap page-width">
         <div class="nd_grid">
          {% for product in block.settings.collection.products limit:5 %}
            <div class="nd_grid_img nd_grid_img_{{ forloop.index }}" id="nd_img_1">
               <a href="{{ product.url }}">
                {% assign handle = "product_thumb_" | append:forloop.index %} 
               {% assign img = block.settings[handle] | default: product.featured_media.preview_image %}  
                {{ img | image_url:width:700 | image_tag }}
                 <h3>{{ product.title }}</h3>
                 <p>{{ product.price | money }}</p>
              </a>
             </div>
          {% endfor %}
         </div>  
       </div>
     {% endif %}  
  
{%- endfor -%}

{% schema %}
{
  "name": "Lander",
  "max_blocks": 10,
  "settings": [
    {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        }
  ],
  "blocks": [ 
    {
      "type": "2_products",
      "name": "2 Product column",
      "settings": [
        {
          "type": "product",
          "id": "product_1",
          "label": "First Product"
        },
        {
          "type": "image_picker",
          "id": "product_1_img",
          "label": "First Image"
        },
         {
          "type": "product",
          "id": "product_2",
          "label": "Second Product"
        },
        {
          "type": "image_picker",
          "id": "product_2_img",
          "label": "Second Image"
        },
        {
          "type": "checkbox",
          "id": "make_large",
          "label": "Make first product large",
          "default":true
        }
      ]
    },
    {
      "type": "2_banners",
      "name": "2 Banner column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "First Image"
        },
        {
          "type": "product",
          "id": "product_2_img",
          "label": "Product"
        },
         {
          "type": "image_picker",
          "id": "image_2",
          "label": "Second Image"
        },
         {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
         {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "2_banners_product",
      "name": "2 Banner and product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "First Image"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Second Image"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Third Image"
        },
        {
          "type": "text",
          "id": "title_1",
          "label": "First Image title"
        },
                {
          "type": "text",
          "id": "title_2",
          "label": "Second Image title"
        },
        {
          "type":"product",
          "id":"product",
          "label":"Select Product"
        }
      ]
    },
     {
      "type": "featured_collection",
      "name": "Featured collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "product_thumb_1",
          "label": "Product 1 Thumb"
        },
        {
          "type": "image_picker",
          "id": "product_thumb_2",
          "label": "Product 2 Thumb"
        },
        {
          "type": "image_picker",
          "id": "product_thumb_3",
          "label": "Product 3 Thumb"
        },
        {
          "type": "image_picker",
          "id": "product_thumb_4",
          "label": "Product 4 Thumb"
        },
         {
          "type": "image_picker",
          "id": "product_thumb_5",
          "label": "Product 5 Thumb"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lander" 
    }
  ],
  "disabled_on": {
    "groups": ["custom.popups"]
  }
}
{% endschema %}

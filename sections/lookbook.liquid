 

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
 <div class="lookbook_wrap">
          <div class="lb_grid_wrap">
            
            <div class="lb_grid">
              {% for block in section.blocks %}
                {% assign product =  block.settings.product %}
                 {% assign image = block.settings.product_thumb | default:product.featured_image %}
                 
                   <div class="lb_grid_img lb_grid_img_{{ forloop.index }}" id="lb_img_1">
                       <img src="{{ image | image_url:width:800 }}" />
                      <!-- {% for media in product.media %}
                         {% if media.media_type == "image" %}
                              <img src="{{ media.preview_image | image_url:width:500 }}" />
                         {% endif %}  
                      {% endfor %}  -->
                     <h2 class="lb_heading" style="display: none">{{ product.title }}</h2>
                     <img class="lp_featured_img"  style="display: none"  src="{{ product.featured_image | image_url:width:500 }}" />
                       {% if product.description != blank %}
                     <div class="lb_des" style="display: none">{{ product.description | strip_html}}</div>
                         {% endif %}  
                     {% if block.settings.product_thumb2 != blank %}
                        <img class="lp_large_img" style="display: none" src="{{ block.settings.product_thumb2 | image_url:width:800 }}" />
                     {% endif %}  
                     

                     <a href="{{ product.url }}"  class="lb_btn" style="display: none">Discover</a>
                   </div>
              {% endfor %} 
            </div>
           

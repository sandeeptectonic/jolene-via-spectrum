<!-- HTML markup -->
<div id="lg_Modal" class="lg_modal">
  <div class="lg_modal-content">
    <div class="image-container">
      <span class="lg_close">&times;</span>
      <img class="modalImg" src="https://picsum.photos/400/400" />
    </div>
    <div class="content-container">
      <div class="product__title">
      <h2>Title</h2>
      </div>
      <div class="modalFeatImg_box">
        <img class="modalFeatImg" src="" />
      </div>
      <div class="prd_description">
      <p>Description Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
      </div>
      <a href="#" class="btn" target="_blank">Discover</a>
    </div>
  </div>
</div>


<script>

 // Get the modal
var modal = document.getElementById("lg_Modal");

// Get the image containers and insert them inside the modal
var imgContainers = document.querySelectorAll(".lb_grid_img");
var modalImg = document.querySelector(".lg_modal-content .modalImg");
var modalfeatImg = document.querySelector(".lg_modal-content .modalFeatImg");
var modalTitle = document.querySelector(".lg_modal-content h2");
var modalDescription = document.querySelector(".lg_modal-content p");
var modalLink = document.querySelector(".lg_modal-content a");

imgContainers.forEach(function(imgContainer) {
  imgContainer.addEventListener("click", function() {
    // Check screen width
    if (window.innerWidth >= 757) {
      var productImage = this.querySelector(".lp_large_img");
      var featuredImage = this.querySelector(".lp_featured_img");
      var productTitleElement = this.querySelector("h2");
      var productDescriptionElement = this.querySelector(".lb_des");
      var productLinkElement = this.querySelector("a");

      modalImg.src = productImage.src;
      modalfeatImg.src = featuredImage.src;
      modalTitle.textContent = productTitleElement ? productTitleElement.textContent : "";
      modalDescription.textContent = productDescriptionElement ? productDescriptionElement.textContent : "";
      modalLink.href = productLinkElement ? productLinkElement.href : "";

      modal.style.display = "flex";
    } else {
      var productLinkElement = this.querySelector("a");
      window.location.href = productLinkElement;

    }
  });
});


// Get the <span> element that closes the modal
var span = document.getElementsByClassName("lg_close")[0];

// When the user clicks on <span> (x), close the modal
span.onclick = function() {
  modal.style.display = "none";
};

// Get the modal overlay
var modalOverlay = document.querySelector(".lg_modal");

// When the user clicks outside the modal content, close the modal
modalOverlay.addEventListener("click", function(event) {
  if (event.target === modalOverlay) {
    modal.style.display = "none";
  }
});



</script>

</div>

{% schema %}
{
  "name": "Looktest",
  "tag": "section",
  "class": "section",
   "blocks": [
      {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "image_picker",
          "id": "product_thumb",
          "label": "Product Thumb"
        },
        {
          "type": "image_picker",
          "id": "product_thumb2",
          "label": "Product Thumb Large"
        }
      ] 
    }  
   ],
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
   "presets": [
    {
      "name": "Looktest" 
    }
  ]
}
{% endschema %}

{{ 'spectrum-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  DATA SOURCE — Collection resolution
  Priority:
  1. Section setting: collection picker
  2. Fallback: shop metafield (shop.metafields.spectrum.homepage_collection)
  Swap this block to change where the collection comes from.
{%- endcomment -%}

{%- liquid
  assign row_collection = section.settings.collection
  if row_collection == blank
    assign meta_handle = shop.metafields.spectrum.homepage_collection.value
    if meta_handle != blank
      assign row_collection = collections[meta_handle]
    endif
  endif
  assign row_title = section.settings.title
  assign products_limit = section.settings.products_to_show
-%}

{%- if row_collection != blank and row_collection.all_products_count > 0 -%}
  <div class="spectrum-row section-{{ section.id }}-padding">
    <div class="spectrum-row__header">
      {%- if row_title != blank -%}
        <h2 class="spectrum-row__title">{{ row_title }}</h2>
      {%- endif -%}
      <a href="{{ row_collection.url }}" class="spectrum-row__view-all">View All</a>
    </div>

    <div class="spectrum-row__scroll">
      {%- for product in row_collection.products limit: products_limit -%}
        <div class="spectrum-row__item">
          {% render 'card-product',
            card_product: product,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: section.settings.show_vendor,
            section_id: section.id,
            lazy_load: true
          %}
        </div>
      {%- endfor -%}
    </div>
  </div>

{%- else -%}
  {%- comment -%} Placeholder state — no collection selected {%- endcomment -%}
  <div class="spectrum-row section-{{ section.id }}-padding">
    <div class="spectrum-row__header">
      <h2 class="spectrum-row__title">{{ row_title | default: 'Featured Collection' }}</h2>
    </div>
    <div class="spectrum-row__scroll">
      {%- for i in (1..4) -%}
        <div class="spectrum-row__item">
          {% render 'card-product', section_id: section.id %}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection Row",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "NEW COLLECTION"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 12,
      "label": "Maximum products to show"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Collection Row",
      "settings": {
        "title": "NEW COLLECTION"
      }
    }
  ]
}
{% endschema %}

{{ 'spectrum-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  View Similar — Powered by Shopify Product Recommendations (Search & Discovery).
  Uses <product-recommendations> custom element for async loading.
{%- endcomment -%}

<product-recommendations
  class="spectrum-row section-{{ section.id }}-padding no-js-hidden"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
>
  {% if recommendations.performed and recommendations.products_count > 0 %}
    <div class="spectrum-row__header">
      <h2 class="spectrum-row__title">{{ section.settings.heading | default: 'VIEW SIMILAR' }}</h2>
    </div>

    <div class="spectrum-row__scroll">
      {%- for recommendation in recommendations.products -%}
        <div class="spectrum-row__item">
          {% render 'card-product',
            card_product: recommendation,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: false,
            section_id: section.id,
            lazy_load: true
          %}
        </div>
      {%- endfor -%}
    </div>
  {% endif %}
</product-recommendations>

{% schema %}
{
  "name": "View Similar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Powered by Shopify Search & Discovery. Configure recommendations in the Search & Discovery app."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section title",
      "default": "VIEW SIMILAR"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Maximum products to show"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image on hover"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ]
}
{% endschema %}
